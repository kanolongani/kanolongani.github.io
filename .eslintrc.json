{
	"env": {
		"browser": true,
		"es2021": true
	},
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "module"
	},
	"extends": ["eslint:recommended", "prettier"],
	"rules": {
		"no-unused-vars": "warn",
		"no-console": "off",
		"eqeqeq": "error",
		"default-case": "error",
		"no-else-return": "error"
	},
	"overrides": [
		{
			"files": ["*.config.js"],
			"env": { "node": true },
			"parserOptions": { "sourceType": "script" }
		}
	]
}
